# DEVELOPMENT-ONLY TEMPLATE. Copy to .env.development.local; never use it for production.
# Production must use a separately provisioned .env.production that passes the README preflight gate.

# Local port and public build-time configuration. The references stay aligned
# when PORT changes because both browser-facing origins expand from this value.
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:${PORT}
# Optional same-origin ingestion route, for example /api/vitals.
NEXT_PUBLIC_WEB_VITALS_ENDPOINT=

# Development-server resource guard. Values are MiB; the Docker limits accept units.
NEXT_DEV_OLD_SPACE_MB=1536
NEXT_DEV_MEMORY_LIMIT_MB=2048
DEV_CONTAINER_MEMORY_LIMIT=2560m
DEV_CONTAINER_MEMORY_RESERVATION=1024m

# Server-only development placeholders. Never expose these with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_development_only
CONTACT_FROM_EMAIL=Portfolio <portfolio@example.invalid>
CONTACT_TO_EMAIL=owner@example.invalid
CONTACT_IDEMPOTENCY_SECRET=development-only-not-a-production-secret

# Exact browser origins allowed to call POST /api/contact (comma-separated).
CONTACT_ALLOWED_ORIGINS=http://localhost:${PORT}

# Request and delivery safeguards.
CONTACT_MAX_BODY_BYTES=16384
CONTACT_EMAIL_TIMEOUT_MS=8000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_GLOBAL_MAX=100
CONTACT_RATE_LIMIT_WINDOW_SECONDS=60
CONTACT_RATE_LIMIT_MAX_ENTRIES=5000

# Enable only behind a trusted proxy that overwrites this header.
CONTACT_TRUST_PROXY=false
CONTACT_CLIENT_IP_HEADER=x-forwarded-for
CONTACT_TRUST_PROXY_HOPS=1
