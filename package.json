{
  "name": "portifolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:turbo": "node scripts/dev-server.mjs --turbopack",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "start": "node .next/standalone/server.js",
    "analyze": "next experimental-analyze --output",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run test:quality-hook",
    "test:quality-hook": "bash scripts/ai-quality-gate.test.sh",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "install:hooks": "cp scripts/pre-push-e2e.sh .git/hooks/pre-push && chmod +x .git/hooks/pre-push && echo '✅ pre-push E2E hook installed'"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.3.0",
    "next-intl": "^4.13.7",
    "ogl": "1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.74.0",
    "react-icons": "5.6.0",
    "resend": "6.17.2",
    "swiper": "^14.0.7",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/env": "16.3.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4",
    "@types/node": "^24.13.3",
    "@types/react": "19",
    "@types/react-dom": "19",
    "critters": "^0.0.23",
    "eslint": "9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "4",
    "typescript": "5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0 <25",
      "onFail": "warn"
    }
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
